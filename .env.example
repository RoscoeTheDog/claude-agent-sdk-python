# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# API Authentication (choose one)
# Option 1: API Key (pay-per-token)
ANTHROPIC_API_KEY=sk-ant-api-xxxxx-your-key-here

# Option 2: OAuth Subscription (uses your Pro/Max subscription)
# Leave ANTHROPIC_API_KEY unset and ensure ~/.claude/.credentials.json exists
# CLAUDE_USE_SUBSCRIPTION=true

# OAuth Credentials Path (optional override)
# CLAUDE_CREDENTIALS_PATH=~/.claude/.credentials.json

# Testing
# Use mock credentials for testing, never real ones in tests
TEST_MODE=true
